# 이 파일을 .env.local로 복사한 뒤 값을 채워서 사용 (.env.local은 Git에 커밋되지 않음)

# 카카오맵 JavaScript 키 (물건 찾기 지도). 비워 두면 간단한 도식 지도로 표시한다.
# 카카오 개발자 콘솔의 Web 플랫폼에 사용하는 주소(예: http://localhost:5173)가 등록되어 있어야 한다.
VITE_KAKAO_MAP_KEY=

# 별도 WSS 진입점의 전체 주소. 비우면 현재 출처의 /ws/chat에 쿠키로 연결.
# 설정 시 백엔드 CHAT_SOCKET_TICKET_ENABLED=true 및 허용 출처 설정 필요.
# VITE_CHAT_WS_URL=wss://채팅-배포-주소/ws/chat
