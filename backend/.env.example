# .env로 복사 후 값 입력. 운영 변수는 EC2의 .env.prod

# compose.yaml
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# application.yml
# 카카오 로그인용 REST API 키·시크릿
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 읍면동 역지오코딩(카카오 로컬 API)용 REST API 키. 비우면 KAKAO_CLIENT_ID를 쓴다.
# 카카오맵 권한은 최초 활성화 앱 하나에만 자동 부여되고 추가 앱은 심사가 필요하다.
# 로그인 앱에 권한이 없으면 테스트 앱의 REST API 키를 여기에 넣는다 (테스트 앱은 심사 없이 호출된다).
# 권한이 없으면 403이 오고, 그때는 반경 판정으로 폴백한다 (가입은 멈추지 않는다).
KAKAO_REST_API_KEY=

# 읍면동 조회 제공자. kakao | vworld (기본 kakao)
# kakao가 약 40ms 빠르다. 다만 무료 쿼터가 개발자 계정의 첫 카카오맵 활성화 앱
# 하나에만 붙으므로, 쓰려는 앱에 카카오맵 권한이 있어야 한다.
# 권한이 없거나 구·시 이름 검색(서초·분당)이 필요하면 vworld로 바꾼다
REGION_PROVIDER=kakao

# VWorld 오픈API 인증키 (vworld.kr). REGION_PROVIDER=vworld일 때만 쓴다
VWORLD_API_KEY=
