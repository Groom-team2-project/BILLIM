# .env로 복사 후 값 입력. 운영 변수는 EC2의 .env.prod

# compose.yaml
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# application.yml
# 카카오 로그인용 REST API 키·시크릿
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 행정동 역지오코딩(카카오 로컬 API)용 REST API 키. 비우면 KAKAO_CLIENT_ID를 쓴다.
# 카카오맵 권한은 최초 활성화 앱 하나에만 자동 부여되고 추가 앱은 심사가 필요하다.
# 로그인 앱에 권한이 없으면 테스트 앱의 REST API 키를 여기에 넣는다 (테스트 앱은 심사 없이 호출된다).
# 권한이 없으면 403이 오고, 그때는 반경 판정으로 폴백한다 (가입은 멈추지 않는다).
KAKAO_REST_API_KEY=

# 네이버 로그인용 Client ID·Secret (developers.naver.com).
# 발급 전에는 주석 유지 — 빈 값은 기동 실패, 줄이 없으면 자리값으로 기동됨.
# "개발 중" 앱은 멤버로 등록된 아이디만 로그인됨 (전체 공개는 검수 후).
#NAVER_CLIENT_ID=
#NAVER_CLIENT_SECRET=

# 로컬 기본 false, 운영(prod) 기본 true. 비활성화할 때만 false 지정.
# 멀티 인스턴스에서는 모든 백엔드에 true와 같은 비공개 Redis 주소를 설정한다.
# CHAT_REDIS_ENABLED=false
# REDIS_URL=redis://127.0.0.1:6379

# 별도 WSS 주소 준비 후에만 활성화. Redis 필요. 출처는 경로·끝 슬래시 없이 쉼표로 구분.
# CHAT_SOCKET_TICKET_ENABLED=true
# CHAT_SOCKET_ALLOWED_ORIGINS=https://billim.netlify.app
