      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 24,
      "type": "stat",
      "title": "가용성 (목표 99.5%)",
      "description": "5xx가 아닌 응답 비율. 4xx는 사용자 원인이라 제외",
      "datasource": {
        "type": "prometheus",
        "uid": "billim-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.995
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "background",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "billim-prometheus"
          },
          "expr": "1 - (sum(increase(http_server_requests_seconds_count{job=\"billim-app\", env=~\"$env\", uri!~\"/actuator.*\", status=~\"5..\"}[$__range])) or vector(0)) / sum(increase(http_server_requests_seconds_count{job=\"billim-app\", env=~\"$env\", uri!~\"/actuator.*\"}[$__range]))",
          "instant": true,
          "range": false
        }
