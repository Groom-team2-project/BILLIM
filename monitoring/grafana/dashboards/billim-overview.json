{
  "uid": "billim-overview",
  "title": "BILLIM 서버 개요",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "graphTooltip": 1,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "환경",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "billim-prometheus"
        },
        "query": {
          "query": "label_values(up{job=\"billim-app\"}, env)",
          "refId": "env"
        },
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 123,
